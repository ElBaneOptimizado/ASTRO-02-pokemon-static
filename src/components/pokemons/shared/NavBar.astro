---
const links = [
  { href: '/', text: 'Listado' },
  { href: '/pokemons/1', text: 'Paginado' },
  { href: '/favorites', text: 'Favoritos' },
]; 
const currentPath = Astro.url.pathname;
---

<!-- component -->
<nav class="bg-gray-900 shadow dark:bg-slate-900">
    <div class="container flex items-center justify-center p-6 mx-auto text-gray-600 capitalize dark:text-gray-300">
        
            <!-- {
      links.map(({ href, text }) => (
        <a 
          href={href} 
          class:list={["text-white  mx-1.5 sm:mx-6 transition-colors duration-200",
            {
                'border-b-2 border-blue-500': currentPath === href,
            }
          ]}
        >
          {text}
        </a> 
      ))
    } -->
        {
      links.map(({ href, text }) => (
        <div>
          <a
            href={href}
            class="text-white mx-1.5 sm:mx-6 transition-colors duration-200"
          >
            {text}
          </a>
          
          {
            currentPath === href ? (
              <div 
                transition:name="menu-line"
                class="border-b-2 border-blue-500 mx-4" 
              />
            ): (
                <div class="border-b-2 border-transparent" />
            )
          }
        </div>
      ))
    }


       

        <a href="#" class="border-b-2 border-transparent hover:text-gray-800 dark:hover:text-gray-200 hover:border-blue-500 mx-1.5 sm:mx-6">
           
        </a>

        <a href="#" class="border-b-2 border-transparent hover:text-gray-800 dark:hover:text-gray-200 hover:border-blue-500 mx-1.5 sm:mx-6">
            
        </a>
    </div>
</nav>