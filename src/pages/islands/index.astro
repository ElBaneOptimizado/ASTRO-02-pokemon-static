---
import { Counter } from '../../components/Counter.tsx';
import MainLayout from '../../layouts/MainLayout.astro';
import Title from '../../components/pokemons/shared/Title.astro';

const counterValue = 20;
---



<MainLayout title="Islas">
 <Title>Islas</Title>

  <video controls="" autoplay="" transition:persist>
  <source
    src="https://ia804502.us.archive.org/33/items/GoldenGa1939_3/GoldenGa1939_3_512kb.mp4"
    type="video/mp4"
  />
</video>

<div style={{
    height:'2000px',
    backgroundColor:'red',
    opacity: 0.4,
}}
></div>
 <Counter 
    transition:persist="counter"
    transition:persists-props
 client:visible
  initialValue={counterValue} 
  >
    <Title>Counter Island</Title>
</Counter>
  
</MainLayout>