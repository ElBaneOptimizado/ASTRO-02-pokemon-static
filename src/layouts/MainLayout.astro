---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import { siteInfo } from '../consts/site-info.ts';

interface Props {
  title: string;
  image?: string;
  description?: string;
}

const { title = siteInfo.title, description = siteInfo.description, image, } = Astro.props;
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />

    <meta name="description" content={description} />
    <meta name="author" content="Elman Gamboa" />

    <meta property="og:title" content={title} />
    <meta property="og:image" content={image} />
    <meta property="og:description" content={description} />
    <title>{title}</title>
<!-- Se usa <ClientRouter /> (antes ViewTransitions) para convertir la web en una SPA. Evita que la página parpadee al navegar y permite que los componentes no se reinicien. -->
    <ClientRouter />
  </head>
  <body class="bg-slate-900 text-slate-100 min-h-screen">
    <main class="mt-10 mx-auto max-w-3xl px-4">
      <slot />
    </main>
  </body>
</html>